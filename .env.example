# Copy to .env.local — never commit real secrets.

# --- Feature flags ---
# Set true only when prices, stock, legal pages, and PayTR are ready.
NEXT_PUBLIC_DIRECT_SALES_ENABLED=false

# Public site origin (no trailing slash), e.g. https://petiwell.com
NEXT_PUBLIC_SITE_URL=https://petiwell.com

# --- Company (required for checkout / legal) ---
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_PHONE=
COMPANY_EMAIL=petiwelltr@gmail.com
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
# Optional for şahıs işletmesi
COMPANY_MERSIS=

# --- Database (Postgres) ---
DATABASE_URL=

# --- Admin panel ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=
# Production admin login requires a 6-digit authenticator code.
ADMIN_REQUIRE_MFA=true
ADMIN_TOTP_SECRET=
# Enable after creating the first AdminUser through the super-admin API.
ADMIN_DATABASE_AUTH_ENABLED=false

# --- PayTR (server only — never NEXT_PUBLIC_) ---
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
# Public site origin for callback/success URLs, e.g. https://petiwell.com
PAYTR_MERCHANT_OK_URL=
PAYTR_MERCHANT_FAIL_URL=
# Server-to-server notify URL must be absolute HTTPS
# e.g. https://petiwell.com/api/paytr/callback
PAYTR_CALLBACK_URL=

# --- Product prices (KDV dahil TRY) & stock — set before enabling sales ---
# List prices are KDV + standard shipping inclusive (set SHIPPING_FLAT_TRY=0).
PRODUCT_PRICE_PLUS_B=
PRODUCT_STOCK_PLUS_B=
PRODUCT_PRICE_STERILE_PASTE=
PRODUCT_STOCK_STERILE_PASTE=
SHIPPING_FLAT_TRY=0
SHIPPING_FREE_OVER_TRY=0

# --- Promo codes (server-only; never publish live codes on the marketing site) ---
# JSON catalog, or a single set-total code for a 1 TL live test:
# PROMO_CODES=[{"code":"SAVE10","type":"percent_off","value":10,"maxUses":100}]
# PROMO_SET_TOTAL_CODE=
# PROMO_SET_TOTAL_TRY=1
# PROMO_SET_TOTAL_MAX_USES=10

# --- Email (transactional via Resend) ---
# From MUST be @petiwell.com (Resend verified domain). This is not a mailbox.
# Replies go to EMAIL_REPLY_TO / COMPANY_EMAIL (Gmail is fine for Reply-To).
EMAIL_FROM=Petiwell <noreply@petiwell.com>
EMAIL_REPLY_TO=petiwelltr@gmail.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
ORDER_NOTIFY_TO=petiwelltr@gmail.com

# --- Google Analytics / Ads (public IDs are baked at build; leave empty until real) ---
# Prefer either GTM *or* direct GA4+Ads IDs to avoid double-counting the same purchase.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Server-side purchase backup (GA4 Admin → Data streams → Measurement Protocol API secret)
# GA4_API_SECRET=

# --- Invite-only Brand Ambassador pilot ---
# Keep false until the legal/accounting drafts have signed-off final versions.
AMBASSADOR_LEGAL_DOCS_APPROVED=false
AMBASSADOR_DOCUMENT_VERSION=2026-09-17-draft
# Enable only when the site-wide "every second product is 1 TRY" campaign is live.
SECOND_PRODUCT_ONE_TRY_ENABLED=false
AMBASSADOR_COMMISSION_RATE=0.15
AMBASSADOR_CUSTOMER_DISCOUNT=0.10
AMBASSADOR_PRODUCT_VAT_RATE=20
AMBASSADOR_MIN_PAYOUT_TRY=500
AMBASSADOR_REFERRAL_DAYS=30
AMBASSADOR_COMMISSION_HOLD_DAYS=14
AMBASSADOR_FIRST_CONTENT_DAYS=14
AMBASSADOR_FINAL_WARNING_DAYS=3
AMBASSADOR_STANDARD_CORRECTION_HOURS=48
AMBASSADOR_URGENT_CORRECTION_HOURS=24
AMBASSADOR_TERMINATION_NOTICE_DAYS=15
AMBASSADOR_INACTIVITY_DAYS=90
AMBASSADOR_INACTIVITY_WARNING_DAYS=7
AMBASSADOR_INVITE_DAYS=14
AMBASSADOR_MAX_DOCUMENT_BYTES=4194304
AMBASSADOR_RETENTION_DAYS=1825
# Activate only after the desired retention period is configured.
AMBASSADOR_RETENTION_JOB_ENABLED=false

# Generate with: openssl rand -base64 32
AMBASSADOR_DATA_ENCRYPTION_KEY=
AMBASSADOR_HASH_PEPPER=
AMBASSADOR_REFERRAL_SECRET=

# "vercel_blob" uses the connected private Blob store. "s3" uses the fields below.
AMBASSADOR_STORAGE_PROVIDER=vercel_blob
AMBASSADOR_STORAGE_ENDPOINT=
AMBASSADOR_STORAGE_REGION=auto
AMBASSADOR_STORAGE_BUCKET=
AMBASSADOR_STORAGE_ACCESS_KEY_ID=
AMBASSADOR_STORAGE_SECRET_ACCESS_KEY=
AMBASSADOR_STORAGE_FORCE_PATH_STYLE=false

# Uses an isolated ClamAV sandbox by default. An HTTP scanner returning
# {"clean":true} can be configured as an alternative.
AMBASSADOR_FILE_SCAN_PROVIDER=vercel_sandbox
AMBASSADOR_FILE_SCAN_URL=
AMBASSADOR_FILE_SCAN_TOKEN=
CLAMAV_SANDBOX_SNAPSHOT_ID=

# Vercel Cron calls /api/cron/ambassadors with this bearer secret.
CRON_SECRET=

# Generic carrier webhook HMAC secret.
# Carrier adapter sends x-petiwell-signature = HMAC-SHA256(raw JSON).
SHIPMENT_WEBHOOK_SECRET=
